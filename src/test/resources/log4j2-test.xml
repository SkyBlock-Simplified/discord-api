<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only logging config: framework at INFO, chatty transport libs dampened to WARN. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{1.} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="io.netty" level="WARN"/>
        <Logger name="reactor" level="WARN"/>
        <!-- Harness server (REST/gateway) at INFO; raise to DEBUG for REST/gateway detail, TRACE for every built dispatch. -->
        <Logger name="dev.simplified.discordfauxrig" level="INFO"/>
        <!-- Integration driver narrates each driven event at INFO; raise to DEBUG/TRACE for more detail. -->
        <Logger name="dev.simplified.discordapi.integration" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
